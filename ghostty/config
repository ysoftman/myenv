# 현재 키바인딩 조회
# ghostty +list-keybinds
# 디폴트 키바인딩 조회
# ghostty +list-keybinds --default
# cmd+alt+i 로 화면 아래에서 디버거(inspector)창을 토글할 수 있다.
# 설정 리로드
keybind = super+shift+,=reload_config

# theme 리스트 확인(tmux 안에서는 zsh: permission denied: ghostty 발생함)
# ghostty +list-themes
#
# theme= "Embark"
theme= "Argonaut"
# theme= "Atom One Dark"
# theme= "citruszest"

# 테마의 커서 오버라이드 (Embark 커서 색상)
cursor-color = a1efd3
cursor-text = 1e1c31

# reloading the configuration : ctrl+shift+, (Linux) or cmd+shift+, (macOS)
# The syntax is "key = value". The whitespace around the
# equals doesn't matter.
# background = 282c34
background = 000000
foreground = d8d8d8

# Comments start with a `#` and are only valid on their own line.
# Blank lines are ignored!

# ctrl+d(EOF)로 쉘 종료 시 창 유지 (아무 키나 누르면 닫힘)
wait-after-command = true

# 사용자가 직접 창을 닫을 때 확인 (cmd+w, 창 닫기 버튼 등)
# 프로세스 실행중일때만 확인
# confirm-close-surface = true
# 항상 확인
confirm-close-surface = always

# Empty values reset the configuration to the default value
font-family = "FiraCode Nerd Font"
font-size = 17

# Option 키를 Meta 키로 사용 (가장 권장되는 설정)
macos-option-as-alt = true

# 타이틀바 숨김 (native, transparent, tabs, hidden)
macos-titlebar-style = hidden

background-opacity = 1.0
background-blur = true

# 마우스 드래그(블럭지정)시 클립보드로 자동복사
copy-on-select = clipboard

# URL 열기: cmd+click (tmux mouse on 상태에선 tmux 가 클릭을 가로채므로 cmd+shift+click)
# https://ghostty.org/docs/config/reference#link-url
