{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "google/gemini-2.0-flash",
  "autoupdate": true,
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    }
  },
  "provider": {
    "anthropic": {
      "options": {
        "timeout": 300000
      }
    },
    "google": {
      "options": {
        "timeout": 300000
      }
    },
    "openai": {
      "options": {
        "timeout": 300000
      }
    },
    "mlx-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX Local",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "mlx-community/Qwen3-8B-4bit": {
          "name": "Qwen3 8B (4bit)"
        },
        "lmstudio-community/Qwen3-Coder-30B-A3B-Instruct-MLX-4bit": {
          "name": "Qwen3-Coder-30B-A3B-Instruct-MLX-4bit"
        },
        "lmstudio-community/Qwen2.5-Coder-7B-Instruct-MLX-4bit": {
          "name": "Qwen2.5-Coder-7B-Instruct-MLX-4bit"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:latest": {
          "name": "Qwen3 Coder 30.5B"
        }
      }
    }
  },
  "plugin": [
    "oh-my-openagent@latest",
    "@slkiser/opencode-quota"
  ]
}
